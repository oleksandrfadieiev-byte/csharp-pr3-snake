<Window x:Class="SnakeGame.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SnakeGame.App.ViewModels"
        xmlns:core="clr-namespace:SnakeGame.Core;assembly=SnakeGame.Core"
        Title="Змійка" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        Background="#F4F1E8" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:GameViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding StartCommand}" />
        <KeyBinding Key="Space" Command="{Binding PauseCommand}" />
        <KeyBinding Key="Up" Command="{Binding TurnCommand}" CommandParameter="{x:Static core:Direction.Up}" />
        <KeyBinding Key="Down" Command="{Binding TurnCommand}" CommandParameter="{x:Static core:Direction.Down}" />
        <KeyBinding Key="Left" Command="{Binding TurnCommand}" CommandParameter="{x:Static core:Direction.Left}" />
        <KeyBinding Key="Right" Command="{Binding TurnCommand}" CommandParameter="{x:Static core:Direction.Right}" />
        <KeyBinding Key="W" Command="{Binding TurnCommand}" CommandParameter="{x:Static core:Direction.Up}" />
        <KeyBinding Key="S" Command="{Binding TurnCommand}" CommandParameter="{x:Static core:Direction.Down}" />
        <KeyBinding Key="A" Command="{Binding TurnCommand}" CommandParameter="{x:Static core:Direction.Left}" />
        <KeyBinding Key="D" Command="{Binding TurnCommand}" CommandParameter="{x:Static core:Direction.Right}" />
    </Window.InputBindings>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Score, StringFormat=Рахунок: {0}}" Margin="0,0,24,0" />
            <TextBlock FontSize="18" Text="{Binding BestScore, StringFormat=Рекорд: {0}}" Margin="0,0,24,0" />
            <TextBlock FontSize="18" Text="{Binding Length, StringFormat=Довжина: {0}}" Margin="0,0,24,0" />
            <TextBlock FontSize="18" Foreground="#555" Text="{Binding StateName}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock FontSize="14" Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" MinHeight="20" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Старт (Enter)" Command="{Binding StartCommand}" Padding="10,4" Margin="0,0,8,0" Focusable="False" />
                <Button Content="Пауза (пробіл)" Command="{Binding PauseCommand}" Padding="10,4" Margin="0,0,24,0" Focusable="False" />
                <TextBlock Text="Складність:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="Легко" Command="{Binding DifficultyCommand}" CommandParameter="easy" Padding="8,4" Margin="0,0,4,0" Focusable="False" />
                <Button Content="Нормально" Command="{Binding DifficultyCommand}" CommandParameter="normal" Padding="8,4" Margin="0,0,4,0" Focusable="False" />
                <Button Content="Складно" Command="{Binding DifficultyCommand}" CommandParameter="hard" Padding="8,4" Margin="0,0,12,0" Focusable="False" />
                <TextBlock Text="{Binding DifficultyName}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="#3B5D3A" BorderThickness="3" CornerRadius="4">
            <ItemsControl ItemsSource="{Binding Cells}" Width="{Binding FieldWidth}" Height="{Binding FieldHeight}">
                <ItemsControl.Background>
                    <DrawingBrush Viewport="0,0,56,56" ViewportUnits="Absolute" TileMode="Tile">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#A8D08D" Geometry="M0,0 H56 V56 H0Z" />
                                <GeometryDrawing Brush="#9BC57F" Geometry="M0,0 H28 V28 H0Z M28,28 H56 V56 H28Z" />
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </ItemsControl.Background>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CellViewModel}">
                        <Border x:Name="cell" Width="26" Height="26" Margin="1" CornerRadius="6" Background="#3E7C3A" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="head">
                                <Setter TargetName="cell" Property="Background" Value="#1F4F1D" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="apple">
                                <Setter TargetName="cell" Property="Background" Value="#D23B2E" />
                                <Setter TargetName="cell" Property="CornerRadius" Value="13" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="golden">
                                <Setter TargetName="cell" Property="Background" Value="#E8B21C" />
                                <Setter TargetName="cell" Property="CornerRadius" Value="13" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DockPanel>
</Window>
